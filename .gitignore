# `make build` / `go build ./cmd/sc4n` drops the CLI in either of these places.
/sc4n
/cmd/sc4n/sc4n
/bin/
# `go build ./tools/sc4nfixtures` drops the generator here, wherever it is run from.
/sc4nfixtures
/tools/sc4nfixtures/sc4nfixtures
# `make lab` drops the oracle lab the same way.
/sc4nlab
/tools/sc4nlab/sc4nlab
# `go build ./tools/sc4nconfirm` drops the confirmation harness the same way.
/sc4nconfirm
/tools/sc4nconfirm/sc4nconfirm

# Generated big fixtures are written to $TMPDIR by the -tags=bigfixtures
# benchmarks and must never enter git. Small, deterministic fixtures under
# testdata/ ARE committed (the expectation gate diffs them).
/testdata/big/
*.safetensors.tmp

# `go test -cpuprofile` / `-c` droppings and the Python bytecode cache the
# opcode-table generator leaves behind.
*.test
*.prof
__pycache__/
*.pyc

# Editor and OS droppings.
.DS_Store
*~
*.swp
/dist/

# Nothing in this tree is a credential. The ignore list is the second line of
# defence: a scanner's own repository must not become the example it warns about.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
certs/
vault/
pki_vault/
